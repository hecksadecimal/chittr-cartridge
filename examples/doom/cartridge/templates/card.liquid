<section style="display: flex; flex-direction: column; gap: 10px; padding: 12px; border: 1px solid #555; border-radius: 8px">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px"><lc-author></lc-author><lc-menu></lc-menu></div>
  <h2 style="margin: 0">{{ title }}</h2>
  <p style="margin: 0">{{ status }}</p>
  <lc-file name="wad" target="client" accept=".wad" max-bytes="16777216" label="Choose your DOOM WAD"></lc-file>
  <lc-canvas width="320" height="200" fullscreen label="DOOM first-episode port. Choose your own WAD file above, then click the canvas and press Space to start. Arrows or W A S D move and turn; Space fires; F uses or opens doors; M opens the game menu. Keyboard required."></lc-canvas>
  <p style="margin: 0; font-size: 0.8rem; opacity: 0.8">Arrows / WASD: move &amp; turn · Space: fire · F: use · Shift: run · Q/E: strafe · Tab: map · M: menu · P: pause. Escape releases canvas focus.</p>
  <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap">
    <lc-reply></lc-reply>
    <lc-rechitt></lc-rechitt>
  </div>
  <lc-reactions></lc-reactions>
</section>
