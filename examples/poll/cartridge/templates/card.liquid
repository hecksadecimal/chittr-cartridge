<section class="poll" style="display: flex; flex-direction: column; gap: 10px; padding: 12px; border: 1px solid #555; border-radius: 8px">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px"><lc-author></lc-author><lc-menu></lc-menu></div>
  {% if ready %}
  <div style="display: flex; align-items: center; gap: 10px; background-image: url({{ 'pizza.webp' | asset_url }}); background-size: 48px; background-repeat: no-repeat; background-position: right center; min-height: 48px">
    <img src="{{ 'pizza.webp' | asset_url }}" alt="Pizza" width="40" height="40" style="border-radius: 6px">
    <h2 style="font-family: Mono, monospace; font-size: 1.1rem; font-weight: 700; margin: 0">{{ question | escape }}</h2>
  </div>
  <lc-canvas width="360" height="{{ canvasHeight }}" label="Poll answer buttons. Click an answer to vote."></lc-canvas>
  {% if closed %}<p style="font-family: Mono, monospace; font-size: 0.85rem; font-weight: 700; margin: 0">closed</p>{% elsif signedIn == false %}<p style="opacity: 0.7; font-size: 0.85rem; margin: 0">Log in to vote.</p>{% endif %}
  <p style="opacity: 0.7; font-size: 0.85rem; margin: 0">{{ total }} votes{% if views %} · {{ views }} views{% endif %}</p>
  {% else %}
  <p style="margin: 0; font-family: Mono, monospace">{{ waitMessage | escape }}</p>
  {% if isAdmin %}
  <form data-lc-control="configure" style="display: flex; flex-direction: column; gap: 7px; padding-top: 10px; border-top: 1px solid #555">
    <p style="margin: 0; font-size: 0.85rem; font-weight: 700">Admin only · Set this poll once to make it ready</p>
    <label for="poll-question" style="font-size: 0.8rem">Question</label>
    <input id="poll-question" type="text" name="question" maxlength="200" aria-label="Poll question" placeholder="What should we ask?" style="min-width: 0; padding: 8px; border: 1px solid #555; border-radius: 5px; background-color: transparent; color: inherit">
    <label for="poll-options" style="font-size: 0.8rem">Answer choices (2–10, one per line)</label>
    <textarea id="poll-options" name="options" maxlength="1000" rows="5" aria-label="Poll answer choices" placeholder="First choice&#10;Second choice" style="min-width: 0; padding: 8px; border: 1px solid #555; border-radius: 5px; background-color: transparent; color: inherit; resize: vertical"></textarea>
    <p style="margin: 0; opacity: 0.7; font-size: 0.75rem">Saving starts the one-hour timer. Choices cannot be changed after the poll is ready.</p>
    <button type="submit" style="padding: 8px 12px; border: 1px solid #555; border-radius: 5px; background-color: transparent; color: inherit; font-weight: 700; cursor: pointer">Set poll and start</button>
  </form>
  {% endif %}
  {% endif %}
  <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap">
    <lc-reply></lc-reply>
    <lc-rechitt></lc-rechitt>
  </div>
  <lc-reactions></lc-reactions>
</section>
