<section style="display: flex; flex-direction: column; gap: 8px; padding: 12px; border: 1px solid rgba(127, 127, 127, 0.35); border-radius: 12px">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px"><lc-author></lc-author><lc-menu></lc-menu></div>
  <lc-canvas width="960" height="640" touch="none" fullscreen label="Place, a shared 512 by 512 pixel board. Tap or click a pixel to select it and see who placed it, pick one of 32 colors, then press Place; each placement starts a 15-second cooldown. Drag to pan, pinch or use the zoom buttons to zoom. Keys: arrow keys move the selection (or pan when nothing is selected), W/A/S/D pan, plus, minus and 0 zoom, Q and E change color, Enter or Space places, Backspace clears the selection. Use the expand button for fullscreen. Log in to place pixels."></lc-canvas>
  <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap">
    <lc-reply></lc-reply>
    <lc-rechitt></lc-rechitt>
  </div>
  <lc-reactions></lc-reactions>
</section>
