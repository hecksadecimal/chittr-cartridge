<section style="display: flex; flex-direction: column; gap: 10px; padding: 12px; border: 1px solid #555; border-radius: 8px">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px"><lc-author></lc-author><lc-menu></lc-menu></div>
  <h2 style="font-family: monospace; font-size: 1.1rem; font-weight: 700; margin: 0">Collaborative canvas</h2>
  <lc-canvas width="960" height="480" touch="none" label="Shared 512 by 512 pixel-art canvas. Select a brush radius and color, then draw with Brush; choose Transparent to clear pixels. Info inspects who last touched one pixel. Pan to move around, use arrow keys and W/A/S/D to pan, and use the zoom controls to change magnification. Current view coordinates appear at the top left. Log in to paint."></lc-canvas>
  {% unless signedIn %}<p style="margin: 0; opacity: 0.7">Log in to add to the shared painting.</p>{% endunless %}
  <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap">
    <lc-reply></lc-reply>
    <lc-rechitt></lc-rechitt>
  </div>
  <lc-reactions></lc-reactions>
</section>
